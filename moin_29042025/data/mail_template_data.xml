<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="email_template_threshold_approval_required" model="mail.template">
            <field name="name">Threshold Approval Required</field>
            <field name="model_id" ref="moin_29042025.model_sales_manager_approval"/>
            <field name="subject">Sale Order Approval Required</field>
            <field name="email_from">{{ user.email_formatted }}</field>
            <field name="partner_to">{{ object.user_id.id }}</field>
            <field name="body_html" type="html">
                <div style="margin: 0px; padding: 0px;">
                    <p style="margin: 0px; padding: 0px; font-size: 13px;">
                        Hello,
                        <t t-out="object.user_id.name or ''"/>
                        <br/>
                        <p style="font-weight: bold">
                            Your Approval Required Please Check on the sales order.
                        </p>
                        <br/>
                        Thank You.
                    </p>
                </div>
            </field>
        </record>
    </data>
</odoo>