<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!--this form view for sales manager approval -->
        <record id="sales_manager_approval_form_view" model="ir.ui.view">
            <field name="name">sales.manager.approval.form.view</field>
            <field name="model">sales.manager.approval</field>
            <field name="arch" type="xml">
                <form string="Sales Manager Approval">
                    <sheet>
                        <group>
                            <field name="user_id"/>
                            <field name="approval_threshold"/>
                            <field name="currency_id"/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <!--this list view for sales manager approval-->
        <record id="sales_manager_approval_list_view" model="ir.ui.view">
            <field name="name">sales.manager.approval.list.view</field>
            <field name="model">sales.manager.approval</field>
            <field name="arch" type="xml">
                <list string="Sales Manager Approval">
                    <field name='user_id'/>
                    <field name='approval_threshold'/>
                    <field name="currency_id"/>
                </list>
            </field>
        </record>

        <!--this action to sales manager approval-->
        <record id="sales_manager_approval_view_action" model="ir.actions.act_window">
            <field name="name">Sales Manager Approval</field>
            <field name="res_model">sales.manager.approval</field>
            <field name="view_mode">list,form</field>
            <field name="view_id" ref="sales_manager_approval_list_view"/>
            <field name="help" type="html">
                <p>Sales Manager Approval</p>
            </field>
        </record>
    </data>
</odoo>