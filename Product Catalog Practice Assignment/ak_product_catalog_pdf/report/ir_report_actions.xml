<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
        <!-- paper format for style one -->
        <record id="paperformat_product_catalog_style_one" model="report.paperformat">
            <field name="name">Product Catalog Style One A4</field>
            <field name="default" eval="True"/>
            <field name="format">A4</field>
            <field name="orientation">Portrait</field>
            <field name="margin_top">15</field>
            <field name="margin_bottom">15</field>
            <field name="margin_left">4</field>
            <field name="margin_right">4</field>
            <field name="header_line" eval="False"/>
            <field name="header_spacing">10</field>
            <field name="dpi">90</field>
        </record>

        <!-- paper format for style two -->
        <record id="paperformat_product_catalog_style_two" model="report.paperformat">
            <field name="name">Product Catalog Style Two A4</field>
            <field name="default" eval="True"/>
            <field name="format">A4</field>
            <field name="orientation">Portrait</field>
            <field name="margin_top">1</field>
            <field name="margin_bottom">1</field>
            <field name="margin_left">1</field>
            <field name="margin_right">1</field>
            <field name="header_line" eval="False"/>
            <field name="header_spacing">0</field>
            <field name="dpi">90</field>
        </record>

        <!-- report action for style two -->
        <record id="action_report_product_catalog_style_two" model="ir.actions.report">
            <field name="name">Product Catalog Style Two</field>
            <field name="model">product.catalog</field>
            <field name="report_type">qweb-pdf</field>
            <field name="report_name">ak_product_catalog_pdf.product_catalog_style_two</field>
            <field name="report_file">ak_product_catalog_pdf.product_catalog_style_two</field>
            <field name="print_report_name">'Product-Catalog-Style-Two'</field>
            <field name="binding_model_id" ref="model_product_catalog"/>
            <field name="paperformat_id" ref="ak_product_catalog_pdf.paperformat_product_catalog_style_two"/>
            <field name="binding_type">report</field>
        </record>

        <!-- report action for style one-->
        <record id="action_report_product_catalog_style_one" model="ir.actions.report">
            <field name="name">Product Catalog Style One</field>
            <field name="model">product.catalog</field>
            <field name="report_type">qweb-pdf</field>
            <field name="report_name">ak_product_catalog_pdf.product_catalog_style_one</field>
            <field name="report_file">ak_product_catalog_pdf.product_catalog_style_one</field>
            <field name="print_report_name">'Product-Catalog-Style-One'</field>
            <field name="binding_model_id" ref="model_product_catalog"/>
            <field name="paperformat_id" ref="ak_product_catalog_pdf.paperformat_product_catalog_style_one"/>
            <field name="binding_type">report</field>
        </record>
    </data>
</odoo>