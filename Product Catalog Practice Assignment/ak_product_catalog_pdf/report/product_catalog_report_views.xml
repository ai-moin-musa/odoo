<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <template id="product_catalog_style_one_external_layout">
        <div class="header">
            <h6 class="text-center font-weight-bold">Generated Product Catalog</h6>
        </div>
        <div class="article">
            <t t-out="0"/>
        </div>
    </template>
    <template id="product_catalog_style_one">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="ak_product_catalog_pdf.product_catalog_style_one_external_layout">
                    <t t-foreach="docs.product_ids" t-as="product_id">
                        <div class="row pb-2 mb-2" style="border-bottom: 2px solid purple">
                            <div class="col-3">
                               <img t-if="product_id.image_128" width="200px" height="200px" t-att-src="image_data_uri(product_id.image_128)"/>
                            </div>
                            <div class="col-9">
                                <h4 class="font-weight-bold text-left"><t t-out="product_id.name"/></h4>
                                <span class="text-center px-4 py-1" style="background-color: gray;"><t t-out="product_id.default_code"/></span>
                            </div>
                        </div>
                    </t>
                </t>
            </t>
        </t>
    </template>

    <record id="action_report_product_catalog_style_one" model="ir.actions.report">
        <field name="name">Product Catalog Style One</field>
        <field name="model">product.catalog</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">ak_product_catalog_pdf.product_catalog_style_one</field>
        <field name="report_file">ak_product_catalog_pdf.product_catalog_style_one</field>
        <field name="print_report_name">'Product-Catalog-Style-One'</field>
        <field name="binding_model_id" ref="model_product_catalog"/>
        <field name="binding_type">report</field>
    </record>

</odoo>