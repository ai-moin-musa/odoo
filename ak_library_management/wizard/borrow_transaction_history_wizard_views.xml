<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!--This form view for borrow transaction history wizard -->
        <record id="borrow_transaction_history_wizard_view_form" model="ir.ui.view">
            <field name="name">borrow.transaction.history.wizard.view.form</field>
            <field name="model">borrow.transaction.history.wizard</field>
            <field name="arch" type="xml">
                <form string="Borrow Transaction History Wizard">
                    <sheet>
                        <group>
                            <field name="customer_id"/>'
                            <field name="books" widget="many2many_tags" context="{'author_book':True}"/>
                            <field name="borrow_start_date"/>
                            <field name="borrow_end_date"/>
                            <field name="deposit_amount" invisible="is_member"/>
                        </group>
                    </sheet>
                    <footer>
                        <button name="action_confirm" string="Confirm" type="object"/>
                        <button name="cancel" special="cancel" string="Cancel"/>
                    </footer>
                </form>
            </field>
        </record>
    </data>
</odoo>