<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
       <record id="email_template_library_book_reminder" model="mail.template">
            <field name="name">Library: Book Reminder</field>
            <field name="model_id" ref="ak_library_management.model_borrow_transaction_history"/>
            <field name="subject">Borrowed Book Reminder</field>
            <field name="email_from">{{ user.email_formatted }}</field>
            <field name="partner_to">{{ object.customer_id.id }}</field>
            <field name="body_html" type="html">
                <div style="margin: 0px; padding: 0px;">
                    <p style="margin: 0px; padding: 0px; font-size: 13px;">
                        Hello,
                        <t t-out="object.customer_id.name or ''"/>
                        <br/>
                        <p style="font-weight: bold">Title:
                            <t t-out="[book.name for book in object.books]"/>
                        </p>
                        <br/>
                        Your book Due Date was
                        <t t-out="object.borrow_end_date or ''"/>
                        <t/>
                        so please returned the above books.
                        <br/>
                        Thank You......
                    </p>
                </div>
            </field>
        </record>

        <!--mail template for renew membership-->
        <record id="email_template_renewal_membership" model="mail.template">
            <field name="name">Library: Renewal Membership</field>
            <field name="model_id" ref="ak_library_management.model_library_member"/>
            <field name="subject">Renewal Membership</field>
            <field name="email_from">{{ user.company_id.email_formatted }}</field>
            <field name="partner_to">{{ object.member_id.id }}</field>
            <field name="body_html" type="html">
                <div style="margin: 0px; padding: 0px;">
                    <p style="margin: 0px; padding: 0px; font-size: 13px;">
                        Dear,
                        <t t-out="object.member_id.name or ''"/>
                        <br/>
                        <p style="font-weight:bold">Member Details:</p>
                        <b>Name:</b> <t t-out="object.member_id.name or ''"/> <br/>
                        <b>Email:</b> <t t-out="object.member_id.email or ''"/><br/>
                        <b>Phone No:</b> <t t-out="object.phone or ''"/><br/>
                        <b>Membership Start Date:</b> <t t-out="object.membership_date or ''"/>
                        <br/>
                        Please renew your Membership.
                        <br/>
                        Thank You.....
                    </p>
                </div>
            </field>
        </record>
    </data>
</odoo>