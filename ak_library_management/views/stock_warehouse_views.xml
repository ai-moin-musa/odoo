<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_inherit_stock_warehouse_add_field_form" model="ir.ui.view">
        <field name="name">stock.warehouse.add.field.form</field>
        <field name="model">stock.warehouse</field>
        <field name="inherit_id" ref="stock.view_warehouse"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='code']" position="after">
                <field name="library_assistant_id" groups="ak_library_management.group_library_admin"/>
                <field name="library_worker_ids" widget="many2many_tags"
                groups="ak_library_management.group_library_assistant,ak_library_management.group_library_admin"/>
            </xpath>
        </field>
    </record>
</odoo>