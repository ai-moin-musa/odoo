<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!--contact details template-->
    <template id="contact_details_template" name="Contact Details">
        <t t-call="website.layout">
            <div class="m-5 border border-5 border-primary rounded" style="height:500px">
                <div class="d-flex">
                    <div class="p-2 w-50" style="margin-top:10px; margin-left:50px">
                        <h1>
                            <t t-out="contact.name"/>
                        </h1>
                    </div>
                    <div class="p-2 flex-shrink-1" style="margin-top:10px">
                        <img t-attf-src="/web/image/res.partner/#{contact.id}/avatar_128?unique=1742977026000"
                             class="card-img-left" style="height:100px; width:100px;"
                             loading='lazy' alt="partner image"/>
                    </div>
                </div>

                <div class="row p-2" style="margin-top:25px">
                    <div class="col-lg-6" style="padding-left:50px">
                        <p>
                            <strong>Company:</strong>
                            <t t-out="contact.company_id.name"/>
                        </p>
                        <p>
                            <strong>Tax ID:</strong>
                            <t t-out="contact.vat"/>
                        </p>
                    </div>
                    <div class="col-lg-6">
                        <p>
                            <strong>Email:</strong>
                            <t t-out="contact.email"/>
                        </p>
                        <p>
                            <strong>Phone:</strong>
                            <t t-out="contact.phone or 'N/A'"/>
                        </p>
                        <p>
                            <strong>Job Position:</strong>
                            <t t-esc="contact.function"/>
                        </p>
                        <p>
                            <strong>Mobile:</strong>
                            <t t-esc="contact.mobile"/>
                        </p>
                        <p>
                            <strong>website:</strong>
                            <t t-esc="contact.website"/>
                        </p>
                    </div>
                </div>
                <p style="margin:80px 0 0 10px;">
                    <a href="/contacts" class="btn btn-primary">Back to Contacts</a>
                </p>
            </div>
        </t>
    </template>

    <!--contact template-->
    <template id="contacts_template">
        <t t-call="website.layout">
            <div class="container">
                <div class="row mb-2 mt-2">
                    <t t-foreach="records" t-as="record">
                        <div class="col-6 col-md-4 mt-1 mb-1">
                            <a t-attf-href="/contacts/{{ slug(record) }}"
                               class="link-offset-2 link-underline link-underline-opacity-0">
                                <div class="card flex-row pe-5">
                                    <img t-attf-src='web/image/res.partner/#{record.id}/avatar_128'
                                         class="card-img-left" style="height:100px; width:100px;"
                                         loading='lazy' alt="partner image"/>
                                    <div class="card-body">
                                        <h5 class="card-title">
                                            <t t-out="record.name"/>
                                        </h5>
                                        <p class="card-text" style="font-size:12px">
                                            <t t-out="record.email"/>
                                        </p>
                                    </div>
                                </div>
                            </a>
                        </div>
                    </t>
                </div>
            </div>
        </t>
    </template>

    <data>
        <!--contact menu-->
        <record id="web_contacts_menu" model="website.menu">
            <field name="name">Contacts</field>
            <field name="url">/contacts</field>
            <field name="parent_id" ref="website.main_menu"/>
        </record>
    </data>
</odoo>