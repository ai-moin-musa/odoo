<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--inherited website_sale product template and extend it-->
    <template id="website_product" inherit_id="website_sale.product">
        <xpath expr="//div[@id = 'product_details']" position="inside">
            <form method="POST" action="/download_images">
                <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"
                       t-nocache="The csrf token must always be up to date."/>
                <input type="hidden" class="product_template_id" name="product_template_id" t-att-value="product.id"/>
                <t t-if="product.is_images_downloadable == True">
                    <button t-if="product.product_image_ids or product.image_1920" class="btn btn-primary"
                            type="submit">
                        <i class="fa fa-download"/>
                        Download Product Images
                    </button>
                </t>
            </form>
        </xpath>
    </template>
</odoo>


