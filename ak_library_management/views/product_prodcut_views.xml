<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="product_template_form_view_inherited" model="ir.ui.view">
            <field name="name">product.template.form.view.inherited</field>
            <field name="name">product.template</field>
            <field name="inherit_id" ref="product.product_template_form_view"/>
            <field name="arch" type="xml">
                <xpath expr="//page[@name='sales']/group[@name='sale']/group[@name='product_template_images']" position="inside">
                    <field name="is_downloadable"/>
                </xpath>
            </field>
        </record>
    </data>
</odoo>