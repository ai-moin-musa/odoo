<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <template id="custom_out_of_stock_template">
        <t t-call="website.layout">
            <div id="out_of_stock_page">
                <div class="container">
                    <div class="row mb-2 mt-2">
                        <t t-foreach="products" t-as="product">
                            <div>
                                <div class="d-flex justify-content-center">
                                    <img t-if="product.image_1920" t-att-src="image_data_uri(product.image_1920)"
                                         class="" style="height:100px; width:100px;"
                                         loading='lazy' alt="product image"/>
                                </div>
                                <div class="d-flex justify-content-center">
                                    <h5 class="d-flex justify-content-left card-title">
                                        <t t-out="product.name"/>
                                    </h5>
                                </div>
                                <div class="d-flex justify-content-center">
                                    <span class="text-danger">
                                        Out Of Stock
                                    </span>
                                </div>
                                <div class="d-flex justify-content-center">
                                    <span>
                                        <t t-out="product.out_of_stock_message"/>
                                    </span>
                                </div>
                            </div>
                        </t>
                    </div>
                </div>
            </div>
        </t>
    </template>
</odoo>