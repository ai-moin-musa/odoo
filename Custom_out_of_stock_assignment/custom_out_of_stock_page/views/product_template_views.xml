<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
        <record id="product_template_form_view" model="ir.ui.view">
            <field name="name">product.template.form.view</field>
            <field name="model">product.template</field>
            <field name="priority">10</field>
            <field name="inherit_id" ref="product.product_template_only_form_view"/>
            <field name="arch" type="xml">
                <xpath expr="//page[@name='sales']/group[@name='sale']" position="before">
                    <group string="Product Availability">
                        <field name="is_out_of_stock"/>
                        <field name="out_of_stock_message" groups="website.group_website_designer,sales_team.group_sale_manager"/>
                    </group>
                </xpath>
            </field>
        </record>
    </data>
</odoo>