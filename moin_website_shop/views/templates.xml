<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- inherited product item template from the website => templates.xml -->
        <template id="product_item_inherited" inherit_id="website_sale.products_item">
            <xpath expr="//div[hasclass('o_wsale_product_btn')]" position="inside">
                <form t-if="product._is_add_to_cart_possible()" action="/shop/cart/update" method="POST">
                    <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"
                           t-nocache="The csrf token must always be up to date."/>
                    <input type="hidden" class="product_id" name="product_id"
                           t-att-value="product.product_variant_id.id"/>
                    <input type="hidden" class="product_template_id" name="product_template_id"
                           t-att-value="product.id"/>
                    <button type="button" id="add_to_cart" t-att-disabled="product.sudo().qty_available == 0"
                            t-attf-class="btn btn-light js_add_cart_json a-submit flex-grow-1" href="#">
                        <span class="fa fa-shopping-cart" role="img" aria-label="Add to Cart"/>
                    </button>
                </form>
            </xpath>
            <xpath expr="//div[hasclass('product_price')]" position="after">
                <div style="width: 100%"/>
                <span t-if="product.sudo().qty_available > 0" class="text-success">On-Hand Quantity:
                    <t t-out="product.sudo().qty_available"/>
                </span>
                <span t-else="" class="text-danger">Out of Stock</span>
            </xpath>
        </template>
    </data>
</odoo>