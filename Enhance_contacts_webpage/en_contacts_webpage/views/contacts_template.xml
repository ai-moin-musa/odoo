<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!--contact details template-->
    <template id="contact_details_template" name="Contact Details">
        <t t-call="website.layout">
             <div class="oe_structure">
                <div class="container" t-if="contact">
                    <div class="shadow-lg card mb-2 mt-2">
                        <div class="card-body">
                            <div id="error_message" class="alert alert-danger" style="display: none;"></div>
                            <form id="contact_form">
                                <div>
                                    <strong class="fs-3 mt-5">
                                        Contact Details Form
                                    </strong>
                                    <img t-if="contact.image_1920" t-att-src="image_data_uri(contact.image_1920)"
                                         class="float-md-end" style="height:80px; width:80px;"/>
                                </div>
                                <div class="form-row">
                                    <div class="form-group col-md-6">
                                        <label for="email">Email</label>
                                        <input name="email" type="email" class="form-control" id="email" placeholder="Email" t-att-value="contact.email" readonly="True"/>
                                        <input type="hidden" class="form-control" id="contact_id" t-att-value="contact.id"/>
                                    </div>
                                    <div class="form-group col-md-6">
                                        <label for="name">Name</label>
                                        <input type="text" class="form-control" id="name"
                                               placeholder="Name" t-att-value="contact.name" readonly="True"/>
                                    </div>
                                </div>
                                <div class="form-group col-md-6">
                                    <label for="address">Address</label>
                                    <input type="textarea" class="form-control" id="address"
                                           placeholder="1234 Main St" t-att-value="contact.contact_address_inline" readonly="True"/>
                                </div>
                                <div class="form-group col-md-6">
                                    <label for="website">Website</label>
                                    <input type="text" class="form-control" id="website"
                                           placeholder="www.website.com" t-att-value="contact.website" readonly="True"/>
                                </div>
                                <div class="form-row">
                                    <div class="form-group col-md-6">
                                        <label for="phone">Phone</label>
                                        <input name="phone" type="tel" class="form-control" id="phone" t-att-value="contact.phone" readonly="True"/>
                                    </div>
                                </div>
                                <div class="d-flex">
                                        <a class="btn btn-primary my-2" href="/contacts" role="button">Back</a>
                                        <button id="save_button" class="btn btn-primary my-2 ms-1" style="display: none;" type="submit">
                                            Save
                                        </button>
                                        <button id="edit_button" class="btn btn-primary my-2 ms-1">
                                            Edit
                                        </button>
                                </div>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        </t>
    </template>

    <!--contact template-->
    <template id="contacts_template">
        <t t-call="website.layout">
            <div class="container">
                <div class="row mb-2 mt-2">
                    <t t-foreach="records" t-as="record">
                        <div class="col-6 col-md-4 mt-1 mb-1">
                            <a t-attf-href="/contacts/{{ slug(record) }}"
                               class="link-offset-2 link-underline link-underline-opacity-0">
                                <div class="card flex-row pe-5">
                                    <img t-if="record.image_1920" t-att-src="image_data_uri(record.image_1920)"
                                         class="card-img-left" style="height:120px; width:120px;"
                                         loading='lazy' alt="contact image"/>
                                    <div class="card-body">
                                        <h5 class="card-title">
                                            <t t-out="record.name"/>
                                        </h5>
                                        <p class="card-text" style="font-size:12px">
                                            <t t-out="record.email"/>
                                        </p>
                                    </div>
                                </div>
                            </a>
                        </div>
                    </t>
                </div>
            </div>
        </t>
    </template>

    <data>
        <!--contact menu-->
        <record id="web_contacts_menu" model="website.menu">
            <field name="name">Contacts</field>
            <field name="url">/contacts</field>
            <field name="parent_id" ref="website.main_menu"/>
        </record>
    </data>
</odoo>